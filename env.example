# Copy to .env next to docker-compose.yml (never commit .env)

# --- Spring / Docker ---
LIFE_API_PORT=8787
LIFE_IMAGE=ghcr.io/zoomzoomtnt/lifeos-ai:latest
# Host interface for the API port. Default 127.0.0.1 (reach it through the Caddy proxy below).
# 0.0.0.0 = plain HTTP on every interface: credentials then travel unencrypted. Avoid.
LIFE_API_BIND=127.0.0.1

# --- HTTPS proxy (optional, compose profile `proxy`) ---
# DNS name that points at this server. When set, CD/deploy.sh start Caddy on 80/443 with an
# automatic Let's Encrypt certificate. Empty = no proxy.
LIFE_DOMAIN=

# --- API auth (Spring Security, docs/auth.md) ---
# Required in production: HMAC key for API key hashes (>= 32 chars). Generate: openssl rand -base64 48
# Keep it in the GitHub secret LIFE_KEY_PEPPER (CD writes it here, mode 600). Never in the DB or repo.
# Changing it invalidates every API key except the admin key (the Admin bot then re-mints them).
LIFE_KEY_PEPPER=
# Required in production: the lifeOS Admin bot's key, as its key id + lowercase hex SHA-256 of the
# secret part (never the key itself; docs/auth.md "Admin key"). GitHub secrets of the same names
# (CD writes them here). Changing them replaces the admin key at the next start.
LIFE_ADMIN_KEY_ID=
LIFE_ADMIN_KEY_SHA256=
# Writes per minute per client (429 above it).
LIFE_AUTH_WRITES_PER_MINUTE=60
# Exposed actuator endpoints (all except health need the admin key; writes are off).
LIFE_ACTUATOR_ENDPOINTS=health,info,metrics

# --- Database: Turso (libSQL over HTTPS) ---
# Required, no default. URL: `turso db show <db> --url` gives libsql://<db>-<org>.turso.io;
# use it as is, as jdbc:libsql:https://<db>-<org>.turso.io, or jdbc:dbeaver:libsql:https://... Token: `turso db tokens create <db>`. Never commit a real token.
# Local SQLite instead: SPRING_PROFILES_ACTIVE=local / docker-compose.local.yml.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- OpenClaw master switch ---
# false = no OpenClaw at all (no webhook calls, no cron wake, no log ingest, no skill sync,
# OpenClaw endpoints return 404). REST API + Turso keep working (Grok Bot calls the API directly).
# Everything below in the OpenClaw section is then optional. Default: true.
OPENCLAW_ENABLED=true

# --- OpenClaw gateway (host, not in this compose) ---
OPENCLAW_GATEWAY=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOOK_TOKEN=
LIFE_OPENCLAW_WAKE=true
LIFE_WEIXIN_CHANNEL=openclaw-weixin
LIFE_PROACTIVE_MODEL=
OPENCLAW_HOOKS_PATH=/hooks
OPENCLAW_HOOK_NAME=life-os

# Required when OPENCLAW_ENABLED=true. Absolute path to the host OpenClaw STATE directory (usually ~/.openclaw).
# Compose mounts this at /openclaw. Do not export it as OPENCLAW_HOME to the OpenClaw CLI —
# the CLI treats OPENCLAW_HOME as Unix $HOME and would write $OPENCLAW_HOME/.openclaw/openclaw.json.
OPENCLAW_HOME=
LIFE_OPENCLAW_FILE_LOG=
