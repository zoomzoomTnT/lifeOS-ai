# Copy to .env next to docker-compose.yml (never commit .env)

# --- Spring / Docker ---
LIFE_API_PORT=8787
LIFE_IMAGE=ghcr.io/zoomzoomtnt/lifeos-ai:latest

# --- Database: Turso (libSQL over HTTPS) ---
# Token: `turso db tokens create lifeos-ai`. Never commit a real token.
TURSO_DATABASE_URL=jdbc:dbeaver:libsql:https://lifeos-ai-zoomzoomtnt.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# --- OpenClaw master switch ---
# false = no OpenClaw at all (no webhook calls, no cron wake, no log ingest, no skill sync,
# OpenClaw endpoints return 404). REST API + Turso keep working (Grok Bot calls the API directly).
# Everything below in the OpenClaw section is then optional. Default: true.
OPENCLAW_ENABLED=true

# --- OpenClaw gateway (host, not in this compose) ---
OPENCLAW_GATEWAY=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOOK_TOKEN=
LIFE_OPENCLAW_WAKE=true
LIFE_WEIXIN_CHANNEL=openclaw-weixin
LIFE_PROACTIVE_MODEL=
OPENCLAW_HOOKS_PATH=/hooks
OPENCLAW_HOOK_NAME=life-os

# Required when OPENCLAW_ENABLED=true. Absolute path to the host OpenClaw STATE directory (usually ~/.openclaw).
# Compose mounts this at /openclaw. Do not export it as OPENCLAW_HOME to the OpenClaw CLI —
# the CLI treats OPENCLAW_HOME as Unix $HOME and would write $OPENCLAW_HOME/.openclaw/openclaw.json.
OPENCLAW_HOME=
LIFE_OPENCLAW_FILE_LOG=
