# HTTPS front for lifeos-api. Certificates are issued and renewed automatically (Let's Encrypt)
# for $LIFE_DOMAIN, which must resolve to this server and have ports 80 + 443 reachable.
# Caddy only adds TLS (+ X-Forwarded-*); the app does all authentication (Bearer API keys).
# Global options. LIFE_ACME_EMAIL (optional) becomes "email <addr>": the ACME account address for
# expiry notices and for ZeroSSL, Caddy's fallback CA when Let's Encrypt refuses (e.g. the shared
# rate limit on sslip.io names). Unset = no email line.
{
	{$CADDY_EMAIL_LINE}
}

{$LIFE_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		# host-only on purpose (no includeSubDomains / preload): sslip.io and other shared parents
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8787

	log {
		output stdout
		format console
	}
}
